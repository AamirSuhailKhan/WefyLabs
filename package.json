{
  "name": "leadscore-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:all": "node scripts/dev.js",
    "dev:concurrently": "concurrently -k -n \"api,web\" -c \"blue,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "python -m uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port 8000 --reload",
    "dev:web": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "test": "cd apps/api && python -m pytest"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
