# ==============================================================================
# WefyLabs Backend API & Worker — Production Environment Template
# ==============================================================================
# CLASSIFICATION CATEGORIES:
#   - SERVER_ONLY         : Backend & Worker runtime only (Never bundle in frontend)
#   - PRODUCTION_REQUIRED : Required for backend / worker boot in production
#   - OPTIONAL            : Default behavior applies if omitted
#
# DOMAIN RULE (Part 33):
#   Replace ${DOMAIN} with the finalized production domain (e.g. yourcompany.com)
# ==============================================================================

# ─── 1. Core Server Environment ──────────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
ENV=production
PROJECT_NAME="WefyLabs API"
VERSION="1.0.0"
API_V1_STR=/api/v1

# [SERVER_ONLY | PRODUCTION_REQUIRED]
API_URL=https://api.${DOMAIN}
FRONTEND_URL=https://app.${DOMAIN}
CORS_ORIGINS=https://app.${DOMAIN},https://${DOMAIN}

# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Cryptographically secure random 64-character secret
SECRET_KEY=

# ─── 2. Supabase PostgreSQL ──────────────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
DATABASE_URL=postgresql+asyncpg://postgres:[DB_PASSWORD]@[DB_HOST]:5432/postgres?ssl=require
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_JWT_SECRET=

# ─── 3. Upstash Redis & Celery ───────────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
REDIS_URL=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379
CELERY_BROKER_URL=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379/0
CELERY_RESULT_BACKEND=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379/1

# ─── 4. AI Engine (Google Gemini API) ────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ─── 5. Email (Brevo SMTP Relay) ─────────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@${DOMAIN}
SMTP_FROM_NAME=WefyLabs Real Estate
SMTP_USE_TLS=true
SMTP_SECURITY=STARTTLS

# ─── 6. Google OAuth 2.0 & Calendar ──────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.${DOMAIN}/auth/callback

# ─── 7. Razorpay Payments (STRICTLY TEST MODE ONLY) ──────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
# LIVE credentials are strictly forbidden for this launch stage.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test
PAYMENTS_EMERGENCY_PAUSE=false

# ─── 8. WhatsApp Integration (STRICTLY DISABLED) ─────────────────────────────
# [SERVER_ONLY | OPTIONAL]
# WhatsApp integration is inactive for launch.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── 9. Alerting & Webhooks ──────────────────────────────────────────────────
# [SERVER_ONLY | OPTIONAL]
ALERT_SLACK_WEBHOOK_URL=
ALERT_PAGERDUTY_ROUTING_KEY=
ALERT_WEBHOOK_URL=

# ─── 10. Platform Super Admin ─────────────────────────────────────────────────
# [SERVER_ONLY | OPTIONAL]
# Comma-separated list of operator email addresses with platform-level access.
# Defaults to empty (no super admins). Set at least one for production operations.
SUPER_ADMIN_EMAILS=admin@yourdomain.com
