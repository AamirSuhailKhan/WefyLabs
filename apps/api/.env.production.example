# =============================================================================
# BeetleLabs Production Environment — REQUIRED VARIABLES
# =============================================================================
# Copy this file to your production secret manager (AWS Secrets Manager,
# Kubernetes Secrets, Vercel Environment Variables, etc.)
#
# !! NEVER commit a populated version of this file to git !!
# !! NEVER set ENV=development in production !!
# =============================================================================

# ─── Application Environment ──────────────────────────────────────────────────
ENV=production

# ─── Backend API URL (used internally between services) ───────────────────────
# This is the URL the backend uses to construct absolute links
API_URL=https://api.beetlelabs.ai
FRONTEND_URL=https://app.beetlelabs.ai

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ─── Cache (Upstash Redis) ───────────────────────────────────────────────────
# Upstash requires rediss:// (TLS) for production
REDIS_URL=

# ─── Security / JWT ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Must be at least 32 characters, cryptographically random
SECRET_KEY=

# Supabase JWT Secret — found in Supabase Dashboard > Settings > API > JWT Secret
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# OAuth credentials from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The EXACT URI added to Google Cloud Console > Authorized Redirect URIs:
# Must be: https://app.beetlelabs.ai/auth/callback  (or your actual domain)
GOOGLE_OAUTH_REDIRECT_URI=https://app.beetlelabs.ai/auth/callback

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Do NOT include trailing slashes
CORS_ORIGINS=https://app.beetlelabs.ai,https://beetlelabs.ai

# ─── Google Gemini AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─── Email (Brevo SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@beetlelabs.ai
SMTP_FROM_NAME=BeetleLabs Real Estate
SMTP_USE_TLS=true

# ─── Razorpay Payments ───────────────────────────────────────────────────────
# IMPORTANT: Use rzp_live_* keys — NOT rzp_test_* in production
# If billing is not ready for launch, set BILLING_ENABLED=false and
# leave these values as rzp_test_placeholder (billing UI will be hidden)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── WhatsApp Meta Cloud API ─────────────────────────────────────────────────
# If WhatsApp is not ready for launch, leave these blank
# WhatsApp features will be automatically hidden from the UI
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WHATSAPP_VERIFY_TOKEN=

# ─── Observability / Alerting (Optional) ─────────────────────────────────────
ALERT_SLACK_WEBHOOK_URL=
ALERT_PAGERDUTY_ROUTING_KEY=
