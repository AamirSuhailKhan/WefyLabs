{
  "project": "WefyLabs Hyperscale Edge",
  "dns": {
    "zone": "wefylabs.com",
    "proxied": true,
    "anycast_routing": "global"
  },
  "caching": {
    "edge_cache_ttl": 7200,
    "browser_cache_ttl": 14400,
    "brotli_compression": true,
    "minify": {
      "js": true,
      "css": true,
      "html": true
    }
  },
  "security": {
    "waf_rules": [
      { "action": "block", "expression": "http.request.uri.path contains '/.env'" },
      { "action": "rate_limit", "threshold": 100, "period": 60, "action_type": "challenge" }
    ],
    "ssl": "full_strict",
    "hsts": {
      "enabled": true,
      "max_age": 31536000,
      "include_subdomains": true
    }
  },
  "multi_region_origins": [
    { "region": "us-east", "endpoint": "api-us.wefylabs.com", "weight": 40 },
    { "region": "eu-central", "endpoint": "api-eu.wefylabs.com", "weight": 30 },
    { "region": "ap-south", "endpoint": "api-in.wefylabs.com", "weight": 30 }
  ]
}
