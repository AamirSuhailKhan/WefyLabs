# ==============================================================================
# WefyLabs Frontend (Next.js) — Production Environment Template
# ==============================================================================
# CLASSIFICATION CATEGORIES:
#   - PUBLIC : Baked into client-side browser bundles (NEXT_PUBLIC_*)
#              NEVER put secrets, database credentials, or private API keys here.
#
# DOMAIN RULE (Part 33):
#   Replace ${DOMAIN} with the finalized production domain (e.g. yourcompany.com)
# ==============================================================================

# [PUBLIC | PRODUCTION_REQUIRED]
# The production API base URL (no trailing slash, include /api/v1)
NEXT_PUBLIC_API_URL=https://api.${DOMAIN}/api/v1

# [PUBLIC | OPTIONAL]
# The frontend client application base URL
NEXT_PUBLIC_FRONTEND_URL=https://app.${DOMAIN}
