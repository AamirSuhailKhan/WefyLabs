# =============================================================================
# BeetleLabs Frontend — Production Environment
# =============================================================================
# For Vercel: add these in Dashboard > Project > Settings > Environment Variables
# For Docker: pass at build time via --build-arg or at runtime via -e
#
# NEXT_PUBLIC_* variables are embedded into the client-side bundle.
# NEVER put secrets here — they will be visible to all users.
# =============================================================================

# The production API base URL (no trailing slash, include /api/v1)
# Example: https://api.beetlelabs.ai/api/v1
NEXT_PUBLIC_API_URL=https://api.beetlelabs.ai/api/v1
