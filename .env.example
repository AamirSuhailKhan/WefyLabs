# ─── BeetleLabs Real-Estate CRM Environment Configuration Template ───

# Environment & Server
ENV=development
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=

# Database (Supabase PostgreSQL / AWS / Self-Hosted)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cache & Distributed Task Queue (Redis / Upstash)
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Primary AI Reasoning Engine (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Knowledge & OCR Engine (Local Open-Source)
KNOWLEDGE_OCR_PROVIDER=tesseract
KNOWLEDGE_EMBEDDING_PROVIDER=gemini
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_STORAGE_PROVIDER=local
KNOWLEDGE_STORAGE_ROOT=./storage/knowledge

# Email Integration (Brevo SMTP Free / Generic SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BeetleLabs Real Estate
SMTP_USE_TLS=true
SMTP_SECURITY=STARTTLS

# WhatsApp Integration (Meta Cloud API / 360dialog)
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth 2.0 (Calendar & Meet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
