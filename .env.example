# ==============================================================================
# WefyLabs Real-Estate CRM — Universal Environment Configuration Template
# ==============================================================================
# CLASSIFICATION CATEGORIES:
#   - PUBLIC              : Exposed to browser / client-side bundles (NEXT_PUBLIC_*)
#   - SERVER_ONLY         : Backend & Celery worker access only (NEVER expose to frontend)
#   - PRODUCTION_REQUIRED : Mandatory for live production operation
#   - STAGING_ONLY        : Specific to staging environments
#   - TEST_ONLY           : Unit / integration test mock configurations
#   - OPTIONAL            : Default values exist; override only when custom behavior needed
#
# DOMAIN RULE (Part 33):
#   Replace ${DOMAIN} with the finalized production domain (e.g., example.com)
#   Production topology:
#     - Frontend: https://app.${DOMAIN}
#     - Backend : https://api.${DOMAIN}
#     - Apex    : https://${DOMAIN}
# ==============================================================================

# ─── 1. ENVIRONMENT & TOPOLOGY ───────────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
ENV=production

# [SERVER_ONLY | PRODUCTION_REQUIRED]
API_URL=https://api.${DOMAIN}

# [SERVER_ONLY | PRODUCTION_REQUIRED]
FRONTEND_URL=https://app.${DOMAIN}

# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Comma-separated list of allowed CORS origins (no trailing slashes)
CORS_ORIGINS=https://app.${DOMAIN},https://${DOMAIN}

# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Minimum 32-character cryptographically random JWT secret
SECRET_KEY=

# ─── 2. PRIMARY DATABASE (Supabase PostgreSQL) ────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Must use postgresql+asyncpg:// with SSL enabled (?ssl=require)
DATABASE_URL=postgresql+asyncpg://postgres:[DB_PASSWORD]@[DB_HOST]:5432/postgres?ssl=require

# [SERVER_ONLY | PRODUCTION_REQUIRED]
SUPABASE_URL=https://[PROJECT_ID].supabase.co

# [SERVER_ONLY | PRODUCTION_REQUIRED]
SUPABASE_JWT_SECRET=

# [PUBLIC | OPTIONAL]
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [SERVER_ONLY | OPTIONAL]
SUPABASE_SERVICE_ROLE_KEY=

# ─── 3. DISTRIBUTED CACHE & TASK QUEUE (Upstash Redis / Celery) ───────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Upstash Redis connection string (rediss:// for TLS)
REDIS_URL=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379

# [SERVER_ONLY | OPTIONAL]
# Defaults to REDIS_URL if omitted
CELERY_BROKER_URL=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379/0
CELERY_RESULT_BACKEND=rediss://default:[REDIS_PASSWORD]@[REDIS_HOST]:6379/1

# ─── 4. REASONING ENGINE (Google Gemini AI) ───────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Google Gemini API key (Production tier with quota)
GEMINI_API_KEY=

# [SERVER_ONLY | OPTIONAL]
GEMINI_MODEL=gemini-2.5-flash

# ─── 5. TRANSACTIONAL EMAIL (Brevo SMTP Relay) ────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@${DOMAIN}
SMTP_FROM_NAME=WefyLabs Real Estate
SMTP_USE_TLS=true
SMTP_SECURITY=STARTTLS

# ─── 6. GOOGLE WORKSPACE OAUTH & CALENDAR ─────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Google Cloud Console OAuth 2.0 Web Client ID & Secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [SERVER_ONLY | PRODUCTION_REQUIRED]
# Must match Authorized Redirect URI in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=https://app.${DOMAIN}/auth/callback

# ─── 7. PAYMENT GATEWAY (Razorpay) ────────────────────────────────────────────
# [SERVER_ONLY | PRODUCTION_REQUIRED]
# MANDATORY SAFETY RULE: TEST keys ONLY (rzp_test_*) — LIVE mode is STRICTLY DISABLED
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test
PAYMENTS_EMERGENCY_PAUSE=false

# ─── 8. WHATSAPP GATEWAY (Meta Cloud API / 360dialog) ─────────────────────────
# [SERVER_ONLY | OPTIONAL]
# MANDATORY SAFETY RULE: WHATSAPP IS STRICTLY DISABLED FOR LAUNCH
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── 9. KNOWLEDGE BASE & LOCAL OCR ────────────────────────────────────────────
# [SERVER_ONLY | OPTIONAL]
KNOWLEDGE_STORAGE_PROVIDER=local
KNOWLEDGE_STORAGE_ROOT=./storage/knowledge
KNOWLEDGE_OCR_PROVIDER=tesseract
KNOWLEDGE_EMBEDDING_PROVIDER=gemini
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001

# ─── 10. OBSERVABILITY & ALERTING ─────────────────────────────────────────────
# [SERVER_ONLY | OPTIONAL]
ALERT_SLACK_WEBHOOK_URL=
ALERT_PAGERDUTY_ROUTING_KEY=
ALERT_WEBHOOK_URL=

# ─── 11. FRONTEND PUBLIC RUNTIME CONFIGURATION ────────────────────────────────
# [PUBLIC | PRODUCTION_REQUIRED]
# Browser-accessible backend API base endpoint
NEXT_PUBLIC_API_URL=https://api.${DOMAIN}/api/v1

# [PUBLIC | OPTIONAL]
NEXT_PUBLIC_FRONTEND_URL=https://app.${DOMAIN}
