# ==============================================================================
# WEFYLABS COMMERCIAL PILOT ENVIRONMENT TEMPLATE (.env.pilot.example)
# ==============================================================================
# This template defines required environment variables for running the WefyLabs
# API in a dedicated, isolated commercial broker pilot tier.
#
# INSTRUCTIONS:
# 1. Copy this file to .env.pilot: cp .env.pilot.example .env.pilot
# 2. Populate placeholder values (<...>) from your secure password vault.
# 3. Never commit .env.pilot to version control.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=pilot
DEBUG=false
APP_NAME="WefyLabs Autonomous Revenue OS (Commercial Pilot Tier)"

# Dedicated Pilot Database (Target DB: leadscore_pilot at revision 0049)
# Format: postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/leadscore_pilot
DATABASE_URL=postgresql+asyncpg://<OPERATOR_SUPPLIED_DB_USER>:<OPERATOR_SUPPLIED_DB_PASSWORD>@<OPERATOR_SUPPLIED_DB_HOST>:5432/leadscore_pilot
ALEMBIC_SCHEMA=public

# Dedicated Redis Instance / Database Indexes for Pilot
REDIS_URL=redis://<OPERATOR_SUPPLIED_REDIS_HOST>:6379/1
CELERY_BROKER_URL=redis://<OPERATOR_SUPPLIED_REDIS_HOST>:6379/2
CELERY_RESULT_BACKEND=redis://<OPERATOR_SUPPLIED_REDIS_HOST>:6379/3

# Security, Privacy & PII Redaction
JWT_SECRET_KEY=<OPERATOR_SUPPLIED_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REDACT_PII=true

# AI Provider Gateway (Configurable Gemini Model)
# Supported Stable Model IDs: gemini-3.6-flash (Standard), gemini-3.8-flash (High Performance)
GEMINI_MODEL_ID=gemini-3.6-flash
DEFAULT_LLM_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=<OPERATOR_SUPPLIED_GOOGLE_AI_API_KEY>

# Outbound Side-Effect Containment Locks (Dry-Run Mode Strictly Enforced in Pilot)
WHATSAPP_DRY_RUN=true
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<OPERATOR_SUPPLIED_WEBHOOK_VERIFY_TOKEN>
WHATSAPP_APP_SECRET=<OPERATOR_SUPPLIED_META_APP_SECRET>

GOOGLE_CALENDAR_DRY_RUN=true
GOOGLE_CLIENT_ID=<OPERATOR_SUPPLIED_GOOGLE_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<OPERATOR_SUPPLIED_GOOGLE_CLIENT_SECRET>

RAZORPAY_SANDBOX=true
RAZORPAY_KEY_ID=<OPERATOR_SUPPLIED_RZP_TEST_KEY_ID>
RAZORPAY_KEY_SECRET=<OPERATOR_SUPPLIED_RZP_TEST_KEY_SECRET>

# Commercial Pilot Governance
MAX_PILOT_LEADS_PER_ORG=100
MAX_PILOT_BROKER_SEATS=10
EXPORT_DATA_ENABLED=true
DATA_RETENTION_DAYS=90
